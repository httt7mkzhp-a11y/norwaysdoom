{
  "name": "norwaysdoom",
  "version": "0.1.0",
  "private": true,
  "description": "Sanntidsteller og utforsker for norske overføringer til utlandet over statsbudsjettet",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
